    "/drive/analyze-talent": {
      "post": {
        "summary": "Analyze Talent From Drive",
        "description": "Analyze talent data from Google Drive folder and find deals\nIf folder_id is not provided, will analyze files in the main folder",
        "operationId": "analyze_talent_from_drive_drive_analyze_talent_post",
        "parameters": [
          {
            "name": "folder_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Folder Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "description": "Number of deals to find",
              "default": 10,
              "title": "Limit"
            },
            "description": "Number of deals to find"
          },
          {
            "name": "export_csv",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Export results to CSV",
              "default": true,
              "title": "Export Csv"
            },
            "description": "Export results to CSV"
          },
          {
            "name": "create_sheet",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Create Google Sheet with results",
              "default": true,
              "title": "Create Sheet"
            },
            "description": "Create Google Sheet with results"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
