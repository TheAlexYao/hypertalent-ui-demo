  "components": {
    "schemas": {
      "DealSearchRequest": {
        "properties": {
          "drive_link": {
            "type": "string",
            "title": "Drive Link"
          },
          "prompt": {
            "type": "string",
            "title": "Prompt"
          },
          "categories": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Categories"
          },
          "min_company_size": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Company Size"
          },
          "geographic_focus": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Geographic Focus"
          },
          "exclude_industries": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exclude Industries"
          }
        },
        "type": "object",
        "required": [
          "drive_link",
          "prompt"
        ],
        "title": "DealSearchRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "features": {
            "type": "object",
            "title": "Features"
          }
        },
        "type": "object",
        "required": [
          "status",
          "message",
          "features"
        ],
        "title": "HealthResponse"
      },
      "LocalDealSearchRequest": {
        "properties": {
          "folder_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Folder Name",
            "default": ""
          },
          "prompt": {
            "type": "string",
            "title": "Prompt",
            "default": "Find brand partnership opportunities"
          },
          "talent_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Talent Name"
          },
          "limit": {
            "type": "integer",
            "title": "Limit",
            "default": 20
          }
        },
        "type": "object",
        "title": "LocalDealSearchRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WebDealSearchRequest": {
        "properties": {
          "prompt": {
            "type": "string",
            "title": "Prompt",
            "default": "Find innovative brand partnership opportunities"
          },
          "drive_link": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Drive Link"
          },
          "talent_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Talent Name",
            "default": "Talent"
          },
          "limit": {
            "type": "integer",
            "title": "Limit",
            "default": 100
          },
          "categories": {
            "items": {},
            "type": "array",
            "title": "Categories",
            "default": [
              "Lifestyle",
              "Sports",
              "Technology"
            ]
          }
        },
        "type": "object",
        "title": "WebDealSearchRequest"
      }
    }
  }
